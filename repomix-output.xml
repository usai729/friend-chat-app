import { useEffect, useState } from "react";
import { friendshipsAPI, conversationsAPI } from "../api";
import CometChat from "../cometchat";
import {
	CometChatMessageList,
	CometChatMessageComposer,
} from "@cometchat/chat-uikit-react";
import { MessageSquare, ArrowLeft } from "lucide-react";

const Conversations = () => {
	const [friends, setFriends] = useState([]);
	const [selectedFriend, setSelectedFriend] = useState(null);
	const [loading, setLoading] = useState(true);
	const [conversationLoading, setConversationLoading] = useState(false);
	const [error, setError] = useState("");
	const [cometChatReady, setCometChatReady] = useState(false);

	useEffect(() => {
		fetchFriends();
		checkCometChatStatus();
	}, []);

	const checkCometChatStatus = async () => {
		try {
			// Check if CometChat is initialized and user is logged in
			const isLoggedIn = await CometChat.getLoggedinUser();
			if (isLoggedIn) {
				setCometChatReady(true);
			} else {
				console.error("User not logged in to CometChat");
				setError("Authentication error. Please log in again.");
			}
		} catch (err) {
			console.error("CometChat status check failed:", err);
			setError("Chat service unavailable. Please refresh the page.");
		}
	};

	const fetchFriends = async () => {
		try {
			setError("");
			const response = await friendshipsAPI.getFriends();
			setFriends(response.data || []);
		} catch (err) {
			console.error("Error fetching friends", err);
			setError("Failed to load friends");
		} finally {
			setLoading(false);
		}
	};

	const handleSelectFriend = async (friend) => {
		if (!cometChatReady) {
			setError(
				"Chat service not ready. Please wait or refresh the page.",
			);
			return;
		}

		setConversationLoading(true);
		setError("");
		try {
			// Verify friendship exists before allowing chat
			await conversationsAPI.getConversation(friend.id);
			setSelectedFriend(friend);
		} catch (err) {
			console.error("Error loading conversation", err);
			setError(
				"Cannot open conversation with this friend. Friendship may have been removed.",
			);
			setSelectedFriend(null);
		} finally {
			setConversationLoading(false);
		}
	};

	if (loading) {
		return (
			<div className="flex items-center justify-center h-[70vh]">
				<div className="text-gray-500">Loading your friends...</div>
			</div>
		);
	}

	if (!cometChatReady) {
		return (
			<div className="flex flex-col items-center justify-center h-[70vh] bg-white rounded-xl shadow-sm border">
				<MessageSquare
					size={48}
					className="text-gray-300 mb-4"
				/>
				<h3 className="text-xl font-semibold text-gray-700 mb-2">
					Initializing Chat Service
				</h3>
				<p className="text-gray-500">
					Please wait while we connect you...
				</p>
			</div>
		);
	}

	if (friends.length === 0) {
		return (
			<div className="flex flex-col items-center justify-center h-[70vh] bg-white rounded-xl shadow-sm border">
				<MessageSquare
					size={48}
					className="text-gray-300 mb-4"
				/>
				<h3 className="text-xl font-semibold text-gray-700 mb-2">
					No friends yet
				</h3>
				<p className="text-gray-500">Add friends to start chatting!</p>
			</div>
		);
	}

	return (
		<div className="flex gap-4 h-[70vh]">
			{/* Friends List */}
			<div className="w-80 bg-white rounded-xl shadow-sm border overflow-hidden flex flex-col">
				<div className="p-4 border-b bg-gradient-to-r from-blue-500 to-blue-600">
					<h2 className="text-lg font-bold text-white">
						Conversations ({friends.length})
					</h2>
				</div>
				<div className="overflow-y-auto flex-1">
					{friends.map((friend) => (
						<button
							key={friend.id}
							onClick={() => handleSelectFriend(friend)}
							disabled={conversationLoading}
							className={`w-full p-4 border-b text-left hover:bg-gray-50 transition ${
								selectedFriend?.id === friend.id
									? "bg-blue-50 border-l-4 border-l-blue-600"
									: ""
							} disabled:opacity-50 disabled:cursor-not-allowed`}
						>
							<h3 className="font-semibold text-gray-900">
								{friend.name}
							</h3>
							<p className="text-sm text-gray-600">
								{friend.email}
							</p>
						</button>
					))}
				</div>
			</div>

			{/* Chat Area */}
			<div className="flex-1 bg-white rounded-xl shadow-sm border overflow-hidden flex flex-col">
				{error && (
					<div className="p-4 bg-red-50 border-b border-red-200 flex justify-between items-center">
						<p className="text-red-700 text-sm">{error}</p>
						<button
							onClick={() => {
								setError("");
								checkCometChatStatus();
							}}
							className="text-red-600 hover:text-red-800 text-sm underline"
						>
							Retry
						</button>
					</div>
				)}

				{selectedFriend ? (
					<>
						{/* Chat Header */}
						<div className="p-4 border-b bg-gradient-to-r from-blue-500 to-blue-600 flex items-center justify-between">
							<div className="flex items-center space-x-3">
								<button
									onClick={() => setSelectedFriend(null)}
									className="text-white hover:bg-blue-700 p-2 rounded-lg transition"
								>
									<ArrowLeft size={20} />
								</button>
								<div>
									<h3 className="font-bold text-white">
										{selectedFriend.name}
									</h3>
									<p className="text-blue-100 text-sm">
										{selectedFriend.email}
									</p>
								</div>
							</div>
						</div>

						{/* Messages */}
						{conversationLoading ? (
							<div className="flex-1 flex items-center justify-center">
								<div className="text-gray-500">
									Loading conversation...
								</div>
							</div>
						) : cometChatReady ? (
							<div className="flex-1 overflow-hidden flex flex-col">
								<div className="flex-1 overflow-hidden">
									<CometChatMessageList
										user={selectedFriend.cometchat_uid}
										theme="light"
										onError={(error) => {
											console.error(
												"CometChat error:",
												error,
											);
											setError(
												"Error loading messages. Please try again.",
											);
										}}
									/>
								</div>
								<CometChatMessageComposer
									user={selectedFriend.cometchat_uid}
									theme="light"
									onError={(error) => {
										console.error(
											"CometChat composer error:",
											error,
										);
									}}
								/>
							</div>
						) : (
							<div className="flex-1 flex items-center justify-center">
								<div className="text-gray-500">
									Chat service initializing...
								</div>
							</div>
						)}
					</>
				) : (
					<div className="flex-1 flex flex-col items-center justify-center text-gray-500">
						<MessageSquare
							size={48}
							className="text-gray-300 mb-4"
						/>
						<p className="text-lg">
							Select a friend to start chatting
						</p>
					</div>
				)}
			</div>
		</div>
	);
};

export default Conversations;
</file>

